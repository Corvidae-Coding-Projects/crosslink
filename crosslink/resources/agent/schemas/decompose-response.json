{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["phases", "estimated_hours"],
  "properties": {
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "stages", "gate_criteria"],
        "properties": {
          "title": {"type": "string"},
          "description": {"type": "string"},
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "description", "tasks", "depends_on", "agent_count", "complexity_hours"],
              "properties": {
                "title": {"type": "string"},
                "description": {"type": "string"},
                "tasks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["title", "description", "complexity_hours"],
                    "properties": {
                      "title": {"type": "string"},
                      "description": {"type": "string"},
                      "complexity_hours": {"type": "number", "minimum": 0}
                    }
                  }
                },
                "depends_on": {"type": "array", "items": {"type": "string"}},
                "agent_count": {"type": "integer", "minimum": 1},
                "complexity_hours": {"type": "number", "minimum": 0}
              }
            }
          },
          "gate_criteria": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "estimated_hours": {"type": "number", "minimum": 0}
  }
}
