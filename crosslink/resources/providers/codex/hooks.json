{
  "hooks": {
    "PreToolUse": [
      {
        "description": "crosslink:work-check",
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK=\"$(git rev-parse --show-toplevel 2>/dev/null)/.crosslink/integrations/hooks/work-check.py\"; if [ -f \"$HOOK\" ]; then CROSSLINK_HOOK_PROVIDER=codex __PYTHON_PREFIX__ \"$HOOK\"; else exit 0; fi",
            "commandWindows": "powershell -NoProfile -EncodedCommand ",
            "timeout": 7
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "description": "crosslink:post-edit-check",
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK=\"$(git rev-parse --show-toplevel 2>/dev/null)/.crosslink/integrations/hooks/post-edit-check.py\"; if [ -f \"$HOOK\" ]; then CROSSLINK_HOOK_PROVIDER=codex __PYTHON_PREFIX__ \"$HOOK\"; else exit 0; fi",
            "commandWindows": "powershell -NoProfile -EncodedCommand ",
            "timeout": 5
          }
        ]
      },
      {
        "description": "crosslink:heartbeat",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK=\"$(git rev-parse --show-toplevel 2>/dev/null)/.crosslink/integrations/hooks/heartbeat.py\"; if [ -f \"$HOOK\" ]; then CROSSLINK_HOOK_PROVIDER=codex __PYTHON_PREFIX__ \"$HOOK\"; else exit 0; fi",
            "commandWindows": "powershell -NoProfile -EncodedCommand ",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "description": "crosslink:session-start",
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK=\"$(git rev-parse --show-toplevel 2>/dev/null)/.crosslink/integrations/hooks/session-start.py\"; if [ -f \"$HOOK\" ]; then CROSSLINK_HOOK_PROVIDER=codex __PYTHON_PREFIX__ \"$HOOK\"; else exit 0; fi",
            "commandWindows": "powershell -NoProfile -EncodedCommand ",
            "timeout": 131
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "description": "crosslink:prompt-guard",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK=\"$(git rev-parse --show-toplevel 2>/dev/null)/.crosslink/integrations/hooks/prompt-guard.py\"; if [ -f \"$HOOK\" ]; then CROSSLINK_HOOK_PROVIDER=codex __PYTHON_PREFIX__ \"$HOOK\"; else exit 0; fi",
            "commandWindows": "powershell -NoProfile -EncodedCommand ",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "description": "crosslink:subagent-context",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK=\"$(git rev-parse --show-toplevel 2>/dev/null)/.crosslink/integrations/hooks/prompt-guard.py\"; if [ -f \"$HOOK\" ]; then CROSSLINK_HOOK_PROVIDER=codex __PYTHON_PREFIX__ \"$HOOK\"; else exit 0; fi",
            "commandWindows": "powershell -NoProfile -EncodedCommand ",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
